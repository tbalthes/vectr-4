{
  "info": {
    "name": "vectr-4 API (Comprehensive)",
    "_postman_id": "vectr-4-collection-2025-09-04",
    "description": "All major vectr-4 API endpoints for local development and testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "fastApiUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "sb_auth_cookie", "value": "", "type": "string" },
    { "key": "accountId", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "userRuleId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "AI: Chat Title (Gemini)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Summarize this chat\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/ai/title",
          "host": ["{{baseUrl}}"],
          "path": ["api", "ai", "title"]
        }
      }
    },
    {
      "name": "AI: Test Gemini Config",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/ai/test",
          "host": ["{{baseUrl}}"],
          "path": ["api", "ai", "test"]
        }
      }
    },
    {
      "name": "Transactions: List/Filter",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Transactions: Get by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions", "{{transactionId}}"]
        }
      }
    },
    {
      "name": "Transactions: Upload CSV",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"csv\": \"...\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/upload-transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "upload-transactions"]
        }
      }
    },
    {
      "name": "User Rules: List/Proxy",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/user-rules",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user-rules"]
        }
      }
    },
    {
      "name": "User Rules: Get by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/user-rules/{{userRuleId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user-rules", "{{userRuleId}}"]
        }
      }
    },
    {
      "name": "User Rules: Export",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/user-rules/export",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user-rules", "export"]
        }
      }
    },
    {
      "name": "User Rules: Import",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"rules\": []\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/user-rules/import",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user-rules", "import"]
        }
      }
    },
    {
      "name": "User Rules: Preview",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"transactions\": []\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/user-rules/preview",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user-rules", "preview"]
        }
      }
    },
    {
      "name": "Accounts: List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accounts"]
        }
      }
    },
    {
      "name": "Accounts: Create Manual",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institution_id\": \"...\",\n  \"name\": \"...\",\n  \"type\": \"depository\",\n  \"subtype\": \"checking\",\n  \"mask\": \"1234\",\n  \"currency\": \"USD\",\n  \"initial_balance\": 100.0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accounts/manual",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accounts", "manual"]
        }
      }
    },
    {
      "name": "Accounts: Delete",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{accountId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accounts", "{{accountId}}"]
        }
      }
    },
    {
      "name": "Institutions: List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/institutions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "institutions"]
        }
      }
    },
    {
      "name": "Institutions: Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"manual\",\n  \"name\": \"Test Bank\",\n  \"url\": \"https://testbank.example\",\n  \"primary_color\": \"#123456\",\n  \"metadata\": { \"notes\": \"created via Postman\" }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/institutions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "institutions"]
        }
      }
    },
    {
      "name": "Merchants: List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/merchants",
          "host": ["{{baseUrl}}"],
          "path": ["api", "merchants"]
        }
      }
    },
    {
      "name": "Merchants: Search",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/merchants/search?q=starbucks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "merchants", "search"],
          "query": [{ "key": "q", "value": "starbucks" }]
        }
      }
    },
    {
      "name": "Categories: With Icons",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/categories/with-icons",
          "host": ["{{baseUrl}}"],
          "path": ["api", "categories", "with-icons"]
        }
      }
    },
    {
