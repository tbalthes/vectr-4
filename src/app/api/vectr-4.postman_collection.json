          "raw": "{{baseUrl}}/api/aggregator/plaid/create_link_token",
          "host": ["{{baseUrl}}"],
          "path": ["api", "aggregator", "plaid", "create_link_token"]
        }
      }
    },
    {
      "name": "Aggregator: Plaid Exchange Public Token",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/aggregator/plaid/exchange_public_token",
          "host": ["{{baseUrl}}"],
          "path": ["api", "aggregator", "plaid", "exchange_public_token"]
        }
      }
    },
    {
      "name": "Aggregator: Webhook",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/aggregator/webhook",
          "host": ["{{baseUrl}}"],
          "path": ["api", "aggregator", "webhook"]
        }
      }
    }
  ]
}
